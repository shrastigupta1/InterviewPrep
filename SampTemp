<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Question 😌</title>
  <style>
    body {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: #ffe6f0;
    }

    .box {
      text-align: center;
      position: relative;
    }

    h1 {
      margin-bottom: 30px;
    }

    button {
      padding: 12px 25px;
      font-size: 16px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }

    #yes {
      background: #ff4d88;
      color: white;
      margin-right: 20px;
    }

    #no {
      background: #999;
      color: white;
      position: absolute;
    }

    #message {
      margin-top: 30px;
      font-size: 20px;
      color: #d6005c;
      display: none;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>Are you my bf? 💕</h1>

    <button id="yes">Yes</button>
    <button id="no">No</button>

    <div id="message">But you never proposed me 😏</div>
  </div>

  <script>
    const noBtn = document.getElementById("no");
    const yesBtn = document.getElementById("yes");
    const message = document.getElementById("message");

    noBtn.addEventListener("mouseover", () => {
      const x = Math.random() * 300 - 150;
      const y = Math.random() * 200 - 100;
      noBtn.style.transform = `translate(${x}px, ${y}px)`;
    });

    yesBtn.addEventListener("click", () => {
      message.style.display = "block";
    });
  </script>
</body>
</html>
